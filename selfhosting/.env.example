# ==============================================================================
# Dialex Engine Self-Hosting Environment Configuration
# ==============================================================================

# Server Listening Host and Port
# 0.0.0.0 listens on all network interfaces (LAN, Wi-Fi, Tailscale, Docker)
DIALEX_HOST=0.0.0.0:7890
DIALEX_PORT=7890

# Set to true to allow binding to non-loopback IPs without TLS (required for LAN/Docker)
DIALEX_ALLOW_INSECURE_LAN=true

# Persistent data and key storage directory (inside container or host filesystem)
DIALEX_CONFIG_DIR=/root/.config/dialex

# Direct TLS / HTTPS (Optional — leave false if using Caddy, Nginx, or Tailscale)
DIALEX_TLS=false
# DIALEX_TLS_CERT=/path/to/cert.pem
# DIALEX_TLS_KEY=/path/to/key.pem

# Initial Admin Credentials (used if no accounts exist yet)
# DIALEX_ADMIN_USER=admin
# DIALEX_ADMIN_PASSWORD=your_secure_password_here

# AI Provider API Keys (Can also be entered later via the Web Dashboard)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...
# GROK_API_KEY=xai-...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
