# ==============================================================================
# Caddy Reverse Proxy Configuration with Automatic HTTPS & SSE Streaming
# ==============================================================================
# Usage:
#   Replace `debate.yourdomain.com` with your actual domain name.
#   Caddy automatically provisions and renews Let's Encrypt certificates.
# ==============================================================================

debate.yourdomain.com {
    reverse_proxy 127.0.0.1:7890 {
        # Ensure Server-Sent Events (SSE) stream smoothly without buffering
        flush_interval -1
    }

    # Security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/dialex.log
        format console
    }
}
